# CampusQuant AI Environment Configuration Template
# Copy this file to .env and insert your real keys/credentials.

# Secret Key for JWT Session Tokens
SECRET_KEY=campusquant_secret_key_2026_super_secure_jwt_token_auth

# Database URLs
MYSQL_DB_URL=mysql+pymysql://root:@localhost:3306/campusquant_db
SQLITE_DB_URL=sqlite:///./campusquant.db

# Groq LLM API Keys (comma-separated for pool rotation, or single key)
GROQ_API_KEYS=your_groq_api_key_1,your_groq_api_key_2
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=mixtral-8x7b-32768

# Email Service (SMTP Gmail Credentials)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
